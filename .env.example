# Copiar este archivo como .env.local y completar con los datos del proyecto en Supabase
# (Project Settings → API Keys: la publishable key; la URL está en Connect o Data API). El archivo .env.local NO se sube a GitHub.
# Sin estos valores, la app funciona en modo local (localStorage), como antes.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_pegar-aqui-la-clave
